    8 comando: T_LEIA T_IDENTIF
    9        | T_ESCREVA expr
   10        | T_IDENTIF T_ATRIB expr
   11        | T_SE expr T_ENTAO lista_comandos T_FIMSE
   12        | T_SE expr T_ENTAO lista_comandos T_SENAO lista_comandos T_FIMSE
   13        | T_ENQTO expr T_FACA lista_comandos T_FIMENQTO

   14 expr: expr T_MAIS expr
   15     | expr T_MENOS expr
   16     | expr T_MULT expr
   17     | expr T_DIV expr
   18     | expr T_MAIOR expr
